{
  "name": "dsh-plugin-auto-update",
  "version": "0.1.4",
  "description": "Per-package automatic updates for DSH plugin bundles, configured by an allowlist",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "author": "chendaleiQ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chendaleiQ/dsh-plugin-auto-update.git"
  },
  "homepage": "https://github.com/chendaleiQ/dsh-plugin-auto-update#readme",
  "bugs": {
    "url": "https://github.com/chendaleiQ/dsh-plugin-auto-update/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plugin-updater",
    "auto-update"
  ],
  "files": [
    "index.js",
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/index.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  }
}
